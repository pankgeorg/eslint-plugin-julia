{
  "name": "eslint-plugin-julia",
  "version": "0.1.0",
  "private": true,
  "description": "ESLint language plugin for Julia, using Julia's own parser (JuliaSyntax) compiled to WebAssembly",
  "type": "module",
  "license": "MIT",
  "author": "Panagiotis Georgakopoulos",
  "engines": {
    "node": "^22.23.3 || ^24.22.1"
  },
  "peerDependencies": {
    "eslint": "^10.14.0"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "@eslint/core": "^1.2.1",
    "@microsoft/eslint-formatter-sarif": "3.1.0",
    "lint-staged": "17.6.0"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./ast": {
      "types": "./types/ast.d.ts",
      "import": "./src/parser/flags.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "wasm/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE",
    "ECOSYSTEM.md"
  ],
  "scripts": {
    "test": "node scripts/verify-artifact.mjs && node tests/run.js"
  }
}
